{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug QT Zeta Avionics App",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceRoot}/build/appZeta_Avionics",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",

                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build"
        }
    ]
}